{
  "name": "myai",
  "version": "1.0.0",
  "description": "MYAI - a terminal AI coding agent powered by OpenRouter (Nemotron Lightning).",
  "bin": {
    "myai": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/cli/index.js",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "openrouter"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.0",
    "@types/readline-sync": "^1.4.8",
    "typescript": "^5.5.4"
  }
}
